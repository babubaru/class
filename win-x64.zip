class BTCQTCRXApp:
    C_BG = "#0a0a1a"
    C_CARD = "#111122"
    C_ACCENT = "#1a1a3e"
    C_GOLD = "#FFD700"
    C_ORANGE = "#F7931A"
    C_GREEN = "#00FF41"
    C_RED = "#FF4141"
    C_DARK_RED = "#8B0000"
    C_DANGER = "#e94560"
    C_TEXT = "#e0e0e0"
    C_MUTED = "#555555"

    def __init__(self):
        self.root = tk.Tk()
        self.root.title(f"{APP_NAME} v{APP_VERSION}")
        self.root.geometry("640x580")
        self.root.resizable(False, False)
        self.root.configure(bg=self.C_BG)

        self.settings = AppSettings.load()
        self.engine = ProductionEngine(data_dir="./data")
        self.engine.settings = self.settings
        self.engine.on_log = self._on_engine_log
        self.engine.on_funded = self._on_engine_funded

        self._build_ui()
        self._start_ui_updater()

    def _build_ui(self):
        # Header
        header = tk.Frame(self.root, bg=self.C_BG)
        header.pack(pady=(12, 2), padx=20, fill='x')
        logo_frame = tk.Frame(header, bg=self.C_BG)
        logo_frame.pack(anchor='center')
        tk.Label(logo_frame, text="₿ ", font=("Segoe UI", 24, "bold"),
                 fg=self.C_GOLD, bg=self.C_BG).pack(side='left')
        tk.Label(logo_frame, text=APP_NAME, font=("Consolas", 24, "bold"),
                 fg=self.C_ORANGE, bg=self.C_BG).pack(side='left')
        tk.Label(header, text=APP_TAGLINE, font=("Consolas", 8), fg=self.C_MUTED,
                 bg=self.C_BG).pack(anchor='center')
        tk.Frame(self.root, height=1, bg=self.C_MUTED).pack(fill='x', padx=30, pady=(4, 6))

        # Wallet card
        wallet_card = tk.Frame(self.root, bg=self.C_CARD, bd=0,
                              highlightbackground=self.C_ACCENT, highlightthickness=1)
        wallet_card.pack(pady=(3, 2), padx=20, fill='x', ipady=6)
        row_w = tk.Frame(wallet_card, bg=self.C_CARD)
        row_w.pack(padx=14, pady=(6, 2), fill='x')
        tk.Label(row_w, text="WALLET", font=("Consolas", 10, "bold"),
                 fg=self.C_GOLD, bg=self.C_CARD).pack(side='left')
        self.wallet_status = tk.Label(row_w, text="● IDLE", font=("Consolas", 10, "bold"),
                                       fg=self.C_MUTED, bg=self.C_CARD)
        self.wallet_status.pack(side='right')

        self.wallet_b32_var = tk.StringVar(value="bc1...  awaiting scan")
        tk.Label(wallet_card, textvariable=self.wallet_b32_var,
                 font=("Consolas", 8), fg="#aaaaaa", bg=self.C_CARD,
                 anchor='w').pack(padx=14, pady=(0, 0), fill='x')
        self.wallet_eth_var = tk.StringVar(value="0x...  awaiting scan")
        tk.Label(wallet_card, textvariable=self.wallet_eth_var,
                 font=("Consolas", 8), fg="#888888", bg=self.C_CARD,
                 anchor='w').pack(padx=14, pady=(0, 4), fill='x')

        # Status card
        status_card = tk.Frame(self.root, bg=self.C_CARD, bd=0,
                              highlightbackground=self.C_ACCENT, highlightthickness=1)
        status_card.pack(pady=2, padx=20, fill='x', ipady=6)
        row_s = tk.Frame(status_card, bg=self.C_CARD)
        row_s.pack(padx=14, pady=(6, 1), fill='x')
        tk.Label(row_s, text="STATUS", font=("Consolas", 10, "bold"),
                 fg=self.C_GOLD, bg=self.C_CARD).pack(side='left')
        self.run_status = tk.Label(row_s, text="● STOPPED", font=("Consolas", 10, "bold"),
                                    fg=self.C_MUTED, bg=self.C_CARD)
        self.run_status.pack(side='right')

        self.stats_var = tk.StringVar(value="Scanned: 0  |  Rate: 0.0/s  |  Hits: 0  |  USD: $0.00")
        tk.Label(status_card, textvariable=self.stats_var,
                 font=("Consolas", 9), fg="#888888",
                 bg=self.C_CARD, anchor='w').pack(padx=14, pady=(1, 6), fill='x')

        # API card
        api_card = tk.Frame(self.root, bg=self.C_CARD, bd=0,
                           highlightbackground=self.C_ACCENT, highlightthickness=1)
        api_card.pack(pady=2, padx=20, fill='x', ipady=3)
        self.api_var = tk.StringVar(value="API: idle  |  Harvest: ...")
        tk.Label(api_card, textvariable=self.api_var,
                 font=("Consolas", 8), fg="#666666",
                 bg=self.C_CARD, anchor='w').pack(padx=14, pady=4, fill='x')

        # Progress
        self.progress = ttk.Progressbar(self.root, mode='indeterminate', length=580)
        self.progress.pack(pady=(6, 2))

        # Buttons
        btn_frame = tk.Frame(self.root, bg=self.C_BG)
        btn_frame.pack(pady=(8, 4))

        self.scan_btn = tk.Button(btn_frame, text="▶  START SCAN",
                                   font=("Consolas", 11, "bold"),
                                   bg="#1a5c1a", fg="white",
                                   relief='flat', padx=22, pady=7,
                                   cursor="hand2", activebackground="#2d7a2d",
                                   command=self._toggle_engine)
        self.scan_btn.pack(side='left', padx=4)

        self.settings_btn = tk.Button(btn_frame, text="⚙  SETTINGS",
                                       font=("Consolas", 10, "bold"),
                                       bg=self.C_ACCENT, fg=self.C_GOLD,
                                       relief='flat', padx=16, pady=7,
                                       cursor="hand2",
                                       command=self._show_settings)
        self.settings_btn.pack(side='left', padx=4)

        self.donate_btn = tk.Button(btn_frame, text="₿  DONATE",
                                     font=("Consolas", 10, "bold"),
                                     bg=self.C_ACCENT, fg=self.C_GOLD,
                                     relief='flat', padx=16, pady=7,
                                     cursor="hand2",
                                     command=self._show_donations)
        self.donate_btn.pack(side='left', padx=4)

        # Log console
        log_frame = tk.Frame(self.root, bg=self.C_BG)
        log_frame.pack(pady=(4, 2), padx=20, fill='both', expand=True)

        self.log_console = scrolledtext.ScrolledText(
            log_frame, height=8,
            bg="#050510", fg=self.C_GREEN,
            font=("Consolas", 8),
            insertbackground=self.C_GREEN,
            relief='flat', bd=0
        )
        self.log_console.pack(fill='both', expand=True)
        self.log(f"[{APP_NAME} v{APP_VERSION}] Initialized — {datetime.now().isoformat()}")
        self.log(f"[SETTINGS] Harvest: {self.settings.harvest_address}")
        self.log(f"[SETTINGS] Auto Harvest: {'ON' if self.settings.auto_harvest else 'OFF'}")
        self.log(f"[SETTINGS] Random Delay: {'ON' if self.settings.random_delay else 'OFF'}")
        self.log(f"[SETTINGS] Verbose Mode: {'ON' if self.settings.verbose_mode else 'OFF'}")

        # Footer
        footer = tk.Frame(self.root, bg=self.C_BG)
        footer.pack(side='bottom', pady=(2, 6))
        tk.Label(footer,
                 text=f"{APP_NAME} v{APP_VERSION}  •  github.com/babubaru/mild",
                 font=("Consolas", 7), fg="#333333", bg=self.C_BG).pack()

    def _start_ui_updater(self):
        self._update_ui()

    def _update_ui(self):
        if hasattr(self, 'engine'):
            stats = self.engine.get_stats()
            cw = self.engine.current_wallet

            if cw:
                self.wallet_b32_var.set(f"Bech32: {cw.bech32_address}")
                self.wallet_eth_var.set(f"ETH:    {cw.ethereum_address}")
                if cw.status == "FUNDED":
                    self.wallet_status.config(text=f"● FUNDED! ${cw.balance_usd:.2f}", fg=self.C_GREEN)
                elif cw.status == "CHECKING":
                    self.wallet_status.config(text="● SCANNING", fg="#FFA500")
                else:
                    self.wallet_status.config(text="● EMPTY", fg=self.C_RED)
            else:
                self.wallet_b32_var.set("bc1...  awaiting scan")
                self.wallet_eth_var.set("0x...  awaiting scan")
                self.wallet_status.config(text="● IDLE", fg=self.C_MUTED)

            if stats['running']:
                self.run_status.config(text="● RUNNING", fg=self.C_GREEN)
            else:
                self.run_status.config(text="● STOPPED", fg=self.C_DARK_RED)

            elapsed = stats['elapsed']
            h, m = divmod(int(elapsed), 3600)
            m, s = divmod(m, 60)
            time_str = f"{h:02d}:{m:02d}:{s:02d}"

            self.stats_var.set(
                f"Scanned: {stats['checked']:,}  |  "
                f"Rate: {stats['rate']:.1f}/s  |  "
                f"Hits: {stats['funded_btc']}  |  "
                f"USD: ${stats['total_usd']:.2f}  |  "
                f"⏱ {time_str}"
            )

            self.api_var.set(
                f"API: {stats['last_api']}  |  "
                f"OK: {stats['api_success']}  |  "
                f"FAIL: {stats['api_fail']}  |  "
                f"Harvest: {'ON' if stats['auto_harvest'] else 'OFF'} → {stats['harvest_addr'][:20]}..."
            )

            if stats['running']:
                self.progress.start(15)
            else:
                self.progress.stop()

        self.root.after(100, self._update_ui)

    def _toggle_engine(self):
        if self.engine.running:
            self.engine.stop()
            self.scan_btn.config(text="▶  START SCAN", bg="#1a5c1a")
            self.log("Scan stopped by user")
        else:
            self.scan_btn.config(text="⏹  STOP SCAN", bg=self.C_DANGER)
            self.engine.start()

    def _show_settings(self):
        SettingsDialog(self.root, self.settings, self._on_settings_save)

    def _show_donations(self):
        DonationDialog(self.root)

    def _on_settings_save(self, settings: AppSettings):
        self.settings = settings
        self.engine.settings = settings
        settings.save()
        self.log(f"[SETTINGS] Harvest: {settings.harvest_address}")
        self.log(f"[SETTINGS] Auto Harvest: {'ON' if settings.auto_harvest else 'OFF'}")
        self.log(f"[SETTINGS] Random Delay: {'ON' if settings.random_delay else 'OFF'}")
        self.log(f"[SETTINGS] Verbose Mode: {'ON' if settings.verbose_mode else 'OFF'}")
        self.log(f"[SETTINGS] Wallet: SET ✓")

    def _on_engine_log(self, msg: str):
        self.log(msg)

    def _on_engine_funded(self, wallet: GeneratedWallet):
        # Flash the window
        self.root.attributes('-alpha', 0.85)
        self.root.after(100, lambda: self.root.attributes('-alpha', 1.0))
        self.root.after(200, lambda: self.root.attributes('-alpha', 0.85))
        self.root.after(300, lambda: self.root.attributes('-alpha', 1.0))

    def log(self, message: str):
        try:
            ts = datetime.now().strftime("%H:%M:%S")
            self.log_console.insert('end', f"[{ts}] {message}\n")
            self.log_console.see('end')
        except:
            pass

    def run(self):
        try:
            self.root.mainloop()
        except KeyboardInterrupt:
            if self.engine.running:
                self.engine.stop()
            sys.exit(0)


# ============================================================
# CLI MODE
# ============================================================

def run_cli():
    import signal
    engine = ProductionEngine(data_dir="./data")
    settings = AppSettings.load()
    engine.settings = settings
    running = True

    def signal_handler(sig, frame):
        nonlocal running
        running = False
        engine.stop()
        print("\n\n[!] Shutting down...")

    signal.signal(signal.SIGINT, signal_handler)

    print(f"\n[*] BTCQTCRX v{APP_VERSION} — CLI Mode")
    print(f"[*] Workers: {settings.workers} | Auto Harvest: {'ON' if settings.auto_harvest else 'OFF'}")
    print(f"[*] Harvest → {settings.harvest_address}")
    print(f"[*] Press Ctrl+C to stop\n")

    def show_stats():
        while running:
            stats = engine.get_stats()
            if stats['checked'] > 0:
                elapsed = stats['elapsed']
                print(
                    f"\r  Scanned: {stats['checked']:,}  |  "
                    f"Rate: {stats['rate']:.1f}/s  |  "
                    f"Hits: {stats['funded_btc']}  |  "
                    f"USD: ${stats['total_usd']:.2f}  |  "
                    f"API: {stats['last_api']:<15}  ",
                    end='', flush=True
                )
            time.sleep(0.5)

    stats_thread = threading.Thread(target=show_stats, daemon=True)
    stats_thread.start()
    engine.start()

    try:
        while running:
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        engine.stop()
        stats = engine.get_stats()
        print(f"\n\n{'='*60}")
        print(f"  SESSION COMPLETE")
        print(f"  Scanned:     {stats['checked']:,}")
        print(f"  Hits (BTC):  {stats['funded_btc']}")
        print(f"  Hits (ETH):  {stats['funded_eth']}")
        print(f"  BTC Found:   {stats['total_btc']:.8f}")
        print(f"  USD Found:   ${stats['total_usd']:.2f}")
        print(f"  API Calls:   {stats['api_success']} OK / {stats['api_fail']} FAIL")
        print(f"{'='*60}")
        print(f"  DONATIONS ACCEPTED:")
        for ticker, info in DONATIONS.items():
            print(f"    {ticker:<4} {info['address']}")
        print(f"{'='*60}")


def run_parse():
    data_dir = sys.argv[2] if len(sys.argv) > 2 else "./data"
    for fname in sorted(os.listdir(data_dir)):
        fpath = os.path.join(data_dir, fname)
        if fname == "output_4.bin":
            entries = DataParser.parse_output_bin(fpath)
            print(f"\n[+] {fname}: {len(entries)} wallet entries")
            funded = [e for e in entries if e['balance_btc'] > 0 or e['balance_eth'] > 0]
            print(f"    Funded: {len(funded)}")
            for e in entries[:3]:
                b32 = e.get('bech32', e.get('address', ''))[:20]
                print(f"    {b32:<22}  BTC={e['balance_btc']:.8f}  ETH={e['balance_eth']:.8f}")
        elif fname == "output_10.data":
            entries = DataParser.parse_json_data(fpath)
            print(f"\n[+] {fname}: {len(entries)} JSON entries")
        elif fname == "output_wallets.csv":
            with open(fpath, 'r') as f:
                lines = f.readlines()
            print(f"\n[+] {fname}: {len(lines)-1} CSV entries")



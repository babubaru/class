def generate_mnemonic(words: int = 12) -> str:
    """Generate a BIP39-compatible mnemonic seed phrase"""
    if words not in (12, 15, 18, 21, 24):
        words = 12
    entropy_bits = words * 11
    entropy_bytes = entropy_bits // 8
    entropy = secrets.token_bytes(entropy_bytes)

    # Checksum: SHA256 first (entropy_bits/32) bits
    h = hashlib.sha256(entropy).digest()
    checksum_bits = entropy_bytes * 8 // 32

    # Combine entropy + checksum bits
    entropy_int = int.from_bytes(entropy, 'big')
    checksum_int = h[0] >> (8 - checksum_bits)
    combined = (entropy_int << checksum_bits) | checksum_int

    # Map to wordlist
    indices = []
    for i in range(words):
        idx = (combined >> (11 * (words - 1 - i))) & 0x7FF
        indices.append(idx)

    mnemonic_words = [BIP39_WORDLIST[idx] for idx in indices]
    return ' '.join(mnemonic_words)


# ============================================================
# CRYPTOGRAPHIC CORE
# ============================================================

BASE58_ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
BECH32_ALPHABET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def _sha256(data: bytes) -> bytes:
    return hashlib.sha256(data).digest()


def _ripemd160(data: bytes) -> bytes:
    h = hashlib.new('ripemd160')
    h.update(data)
    return h.digest()


def _hash160(data: bytes) -> bytes:
    return _ripemd160(_sha256(data))


def _double_sha256(data: bytes) -> bytes:
    return _sha256(_sha256(data))


def _base58_encode(data: bytes) -> str:
    checksum = _double_sha256(data)[:4]
    payload = data + checksum
    n = int.from_bytes(payload, 'big')
    chars = []
    while n > 0:
        n, r = divmod(n, 58)
        chars.append(BASE58_ALPHABET[r])
    for b in payload:
        if b == 0:
            chars.append('1')
        else:
            break
    return ''.join(reversed(chars))


def _bech32_polymod(values):
    GEN = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3]
    chk = 1
    for v in values:
        top = chk >> 25
        chk = (chk & 0x1ffffff) << 5 ^ v
        for i in range(5):
            if (top >> i) & 1:
                chk ^= GEN[i]
    return chk


def _bech32_hrp_expand(hrp: str):
    return [ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp]


def _bech32_create_checksum(hrp: str, data):
    values = _bech32_hrp_expand(hrp) + data
    polymod = _bech32_polymod(values + [0, 0, 0, 0, 0, 0]) ^ 1
    return [(polymod >> 5 * (5 - i)) & 31 for i in range(6)]


def _convertbits(data, frombits, tobits, pad=True):
    acc = 0
    bits = 0
    ret = []
    maxv = (1 << tobits) - 1
    max_acc = (1 << (frombits + tobits - 1)) - 1
    for value in data:
        if value < 0 or (value >> frombits):
            return None
        acc = ((acc << frombits) | value) & max_acc
        bits += frombits
        while bits >= tobits:
            bits -= tobits
            ret.append((acc >> bits) & maxv)
    if pad and bits:
        ret.append((acc << (tobits - bits)) & maxv)
    elif bits >= frombits or ((acc << (tobits - bits)) & maxv):
        return None
    return ret


def _bech32_encode(hrp: str, data) -> str:
    combined = data + _bech32_create_checksum(hrp, data)
    return hrp + '1' + ''.join(BECH32_ALPHABET[d] for d in combined)


def generate_private_key() -> EllipticCurvePrivateKey:
    return ec.generate_private_key(SECP256K1(), default_backend())


def private_key_to_bytes(priv_key: EllipticCurvePrivateKey) -> bytes:
    return priv_key.private_numbers().private_value.to_bytes(32, 'big')


def private_key_to_wif(priv_bytes: bytes, compressed: bool = True) -> str:
    prefix = b'\x80'
    if compressed:
        prefix += priv_bytes + b'\x01'
    else:
        prefix += priv_bytes
    return _base58_encode(prefix)


def public_key_to_bytes(pub_key: EllipticCurvePublicKey, compressed: bool = True) -> bytes:
    nums = pub_key.public_numbers()
    x_bytes = nums.x.to_bytes(32, 'big')
    if compressed:
        prefix = b'\x02' if nums.y % 2 == 0 else b'\x03'
        return prefix + x_bytes
    else:
        y_bytes = nums.y.to_bytes(32, 'big')
        return b'\x04' + x_bytes + y_bytes


def public_key_to_p2pkh_address(pub_bytes: bytes) -> str:
    h = _hash160(pub_bytes)
    return _base58_encode(b'\x00' + h)


def public_key_to_p2sh_p2wpkh_address(pub_bytes: bytes) -> str:
    witness_script = b'\x00\x14' + _hash160(pub_bytes)
    script_hash = _hash160(witness_script)
    return _base58_encode(b'\x05' + script_hash)


def public_key_to_bech32_address(pub_bytes: bytes) -> str:
    h = _hash160(pub_bytes)
    converted = _convertbits(list(h), 8, 5)
    return _bech32_encode('bc', converted)


def public_key_to_ethereum_address(pub_bytes: bytes) -> str:
    if pub_bytes[0] == 0x04:
        pub_bytes = pub_bytes[1:]
    keccak = hashlib.sha3_256(pub_bytes).digest()
    addr = keccak[-20:].hex()
    return f"0x{addr}"


# ============================================================
# DATA STRUCTURES
# ============================================================

@dataclass
class GeneratedWallet:
    """Complete wallet with all address formats + mnemonic"""
    private_key_hex: str
    private_key_wif: str
    public_key_hex: str
    p2pkh_address: str
    p2sh_address: str
    bech32_address: str
    ethereum_address: str
    mnemonic: str = ""
    balance_btc: float = 0.0
    balance_eth: float = 0.0
    balance_usd: float = 0.0
    status: str = "PENDING"
    timestamp: float = 0.0
    scan_time_ms: float = 0.0

    @classmethod
    def generate(cls) -> 'GeneratedWallet':
        t0 = time.time()
        priv_key = generate_private_key()
        priv_bytes = private_key_to_bytes(priv_key)
        pub_key = priv_key.public_key()
        pub_bytes_unc = public_key_to_bytes(pub_key, compressed=False)
        pub_bytes_com = public_key_to_bytes(pub_key, compressed=True)

        return cls(
            private_key_hex=priv_bytes.hex(),
            private_key_wif=private_key_to_wif(priv_bytes, compressed=True),
            public_key_hex=pub_bytes_com.hex(),
            p2pkh_address=public_key_to_p2pkh_address(pub_bytes_com),
            p2sh_address=public_key_to_p2sh_p2wpkh_address(pub_bytes_com),
            bech32_address=public_key_to_bech32_address(pub_bytes_com),
            ethereum_address=public_key_to_ethereum_address(pub_bytes_unc),
            mnemonic=generate_mnemonic(12),
            timestamp=time.time(),
            scan_time_ms=(time.time() - t0) * 1000
        )


# ============================================================
# BLOCKCHAIN CHECKER
# ============================================================

class BlockchainChecker:
    BTC_APIS = [
        {
            "name": "Blockchain.info",
            "url": "https://blockchain.info/balance?active={addr}",
            "parser": lambda data, addr: data.get(addr, {}).get('final_balance', 0) / 1e8,
            "timeout": 8
        },
        {
            "name": "Blockstream",
            "url": "https://blockstream.info/api/address/{addr}",
            "parser": lambda data, addr: (
                data.get('chain_stats', {}).get('funded_txo_sum', 0) -
                data.get('chain_stats', {}).get('spent_txo_sum', 0)
            ) / 1e8,
            "timeout": 8
        },
        {
            "name": "Mempool.space",
            "url": "https://mempool.space/api/address/{addr}",
            "parser": lambda data, addr: (
                data.get('chain_stats', {}).get('funded_txo_sum', 0) -
                data.get('chain_stats', {}).get('spent_txo_sum', 0)
            ) / 1e8,
            "timeout": 8
        }
    ]

    ETH_APIS = [
        {
            "name": "Etherscan",
            "url": "https://api.etherscan.io/api?module=account&action=balance&address={addr}&tag=latest&apikey={apikey}",
            "parser": lambda data, addr: int(data.get('result', 0)) / 1e18,
            "timeout": 8
        }
    ]

    BTC_USD_API = "https://api.coindesk.com/v1/bpi/currentprice/USD.json"
    ETH_USD_API = "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd"

    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) BTCQTCRX/4.0.0'
        })
        self.btc_usd_price = 0.0
        self.eth_usd_price = 0.0
        self.api_stats = {"success": 0, "fail": 0, "last_api": "none"}
        self._last_price_update = 0

    def _update_prices(self):
        now = time.time()
        if now - self._last_price_update < 300:  # Cache 5 min
            return
        try:
            r = self.session.get(self.BTC_USD_API, timeout=5)
            if r.status_code == 200:
                self.btc_usd_price = r.json()['bpi']['USD']['rate_float']
        except:
            pass
        try:
            r = self.session.get(self.ETH_USD_API, timeout=5)
            if r.status_code == 200:
                self.eth_usd_price = r.json()['ethereum']['usd']
        except:
            pass
        self._last_price_update = now

    def check_bitcoin(self, wallet: GeneratedWallet) -> Tuple[float, float, str]:
        self._update_prices()
        addresses = [wallet.bech32_address, wallet.p2pkh_address, wallet.p2sh_address]
        total_btc = 0.0

        for api_config in self.BTC_APIS:
            try:
                url = api_config["url"].format(addr=addresses[0])
                resp = self.session.get(url, timeout=api_config["timeout"])
                if resp.status_code == 200:
                    data = resp.json()
                    balance = api_config["parser"](data, addresses[0])
                    if balance > 0:
                        total_btc += balance
                    self.api_stats["success"] += 1
                    self.api_stats["last_api"] = api_config["name"]
                    return total_btc, total_btc * self.btc_usd_price, api_config["name"]
            except:
                self.api_stats["fail"] += 1
                continue
        return 0.0, 0.0, "none"

    def check_ethereum(self, wallet: GeneratedWallet) -> Tuple[float, float, str]:
        self._update_prices()
        for api_config in self.ETH_APIS:
            try:
                url = api_config["url"].format(addr=wallet.ethereum_address, apikey="")
                resp = self.session.get(url, timeout=api_config["timeout"])
                if resp.status_code == 200:
                    data = resp.json()
                    balance = api_config["parser"](data, wallet.ethereum_address)
                    usd = balance * self.eth_usd_price
                    self.api_stats["success"] += 1
                    self.api_stats["last_api"] = api_config["name"]
                    return balance, usd, api_config["name"]
            except:
                self.api_stats["fail"] += 1
                continue
        return 0.0, 0.0, "none"

    def close(self):
        self.session.close()


# ============================================================
# PRODUCTION ENGINE
# ============================================================

class ProductionEngine:
    OUTPUT_FORMAT_BIN = 1
    OUTPUT_FORMAT_JSON = 2
    OUTPUT_FORMAT_CSV = 4

    def __init__(self, data_dir: str = "./data"):
        self.data_dir = Path(data_dir)
        self.data_dir.mkdir(parents=True, exist_ok=True)

        self.output_bin = self.data_dir / "output_4.bin"
        self.output_json = self.data_dir / "output_10.data"
        self.output_csv = self.data_dir / "output_wallets.csv"
        self.funded_log = self.data_dir / "FUNDED.txt"
        self.harvest_log = self.data_dir / "HARVESTED.txt"

        # Settings
        self.settings = AppSettings.load()

        # Engine config
        self.workers = self.settings.workers
        self.output_flags = self.OUTPUT_FORMAT_BIN | self.OUTPUT_FORMAT_JSON | self.OUTPUT_FORMAT_CSV

        # Runtime state
        self.running = False
        self.paused = False
        self.wallets_checked = 0
        self.wallets_funded_btc = 0
        self.wallets_funded_eth = 0
        self.total_btc_found = 0.0
        self.total_eth_found = 0.0
        self.total_usd_harvested = 0.0
        self.current_wallet: Optional[GeneratedWallet] = None
        self.scan_rate = 0.0
        self.start_time = 0.0
        self.last_rate_time = 0.0
        self.rate_count = 0

        # Callbacks
        self.on_funded: Optional[Callable] = None
        self.on_harvest: Optional[Callable] = None
        self.on_log: Optional[Callable] = None

        # Threading
        self.thread_pool: Optional[ThreadPoolExecutor] = None
        self.result_queue: queue.Queue = queue.Queue()
        self._futures = []
        self._lock = threading.Lock()

        self.checker = BlockchainChecker()

    def log(self, msg: str):
        if self.on_log:
            self.on_log(msg)
        else:
            print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}")

    def generate_and_check(self) -> GeneratedWallet:
        t_start = time.time()
        wallet = GeneratedWallet.generate()
        wallet.status = "CHECKING"

        # Random delay if enabled
        if self.settings.random_delay:
            delay = random.uniform(self.settings.delay_min, self.settings.delay_max)
            time.sleep(delay)

        btc_balance, btc_usd, btc_api = self.checker.check_bitcoin(wallet)
        eth_balance, eth_usd, eth_api = self.checker.check_ethereum(wallet)

        wallet.balance_btc = btc_balance
        wallet.balance_eth = eth_balance
        wallet.balance_usd = btc_usd + eth_usd
        wallet.scan_time_ms = (time.time() - t_start) * 1000

        if btc_balance > 0 or eth_balance > 0:
            wallet.status = "FUNDED"
        else:
            wallet.status = "EMPTY"

        return wallet

    def worker_task(self, worker_id: int):
        while self.running:
            if self.paused:
                time.sleep(0.1)
                continue
            try:
                wallet = self.generate_and_check()
                self.result_queue.put(wallet)

                with self._lock:
                    self.wallets_checked += 1
                    if wallet.balance_btc > 0:
                        self.wallets_funded_btc += 1
                        self.total_btc_found += wallet.balance_btc
                    if wallet.balance_eth > 0:
                        self.wallets_funded_eth += 1
                        self.total_eth_found += wallet.balance_eth
                    if wallet.balance_usd > 0:
                        self.total_usd_harvested += wallet.balance_usd

                    now = time.time()
                    self.rate_count += 1
                    if now - self.last_rate_time >= 2.0:
                        self.scan_rate = self.rate_count / (now - self.last_rate_time)
                        self.rate_count = 0
                        self.last_rate_time = now

            except Exception as e:
                self.log(f"Worker {worker_id} error: {e}")
                time.sleep(1)

    def save_wallet(self, wallet: GeneratedWallet):
        ts = int(wallet.timestamp)

        # Binary
        if self.output_flags & self.OUTPUT_FORMAT_BIN:
            try:
                entry_data = struct.pack(
                    '<I 64s 64s d d I 64s 64s 64s',
                    ts, wallet.p2pkh_address.encode()[:64],
                    wallet.private_key_hex.encode()[:64],
                    wallet.balance_btc, wallet.balance_eth,
                    len(wallet.status),
                    wallet.bech32_address.encode()[:64],
                    wallet.ethereum_address.encode()[:64],
                    wallet.p2sh_address.encode()[:64]
                )
                with open(self.output_bin, 'ab') as f:
                    f.write(entry_data)
            except:
                pass

        # JSON
        if self.output_flags & self.OUTPUT_FORMAT_JSON:
            try:
                entry = {
                    'ts': ts,
                    'datetime': datetime.fromtimestamp(wallet.timestamp).isoformat(),
                    'p2pkh': wallet.p2pkh_address,
                    'p2sh': wallet.p2sh_address,
                    'bech32': wallet.bech32_address,
                    'eth': wallet.ethereum_address,
                    'privkey': wallet.private_key_hex,
                    'wif': wallet.private_key_wif,
                    'pubkey': wallet.public_key_hex,
                    'mnemonic': wallet.mnemonic,
                    'balance_btc': wallet.balance_btc,
                    'balance_eth': wallet.balance_eth,
                    'balance_usd': wallet.balance_usd,
                    'status': wallet.status,
                    'scan_ms': round(wallet.scan_time_ms, 2)
                }
                with open(self.output_json, 'a') as f:
                    f.write(json.dumps(entry) + '\n')
            except:
                pass

        # CSV
        if self.output_flags & self.OUTPUT_FORMAT_CSV:
            try:
                is_new = not self.output_csv.exists()
                with open(self.output_csv, 'a', newline='') as f:
                    writer = csv.writer(f)
                    if is_new:
                        writer.writerow([
                            'timestamp', 'datetime', 'p2pkh', 'p2sh', 'bech32',
                            'ethereum', 'privkey_hex', 'privkey_wif', 'pubkey',
                            'mnemonic', 'balance_btc', 'balance_eth', 'balance_usd',
                            'status', 'scan_ms'
                        ])
                    writer.writerow([
                        ts, datetime.fromtimestamp(wallet.timestamp).isoformat(),
                        wallet.p2pkh_address, wallet.p2sh_address, wallet.bech32_address,
                        wallet.ethereum_address, wallet.private_key_hex,
                        wallet.private_key_wif, wallet.public_key_hex,
                        wallet.mnemonic, wallet.balance_btc, wallet.balance_eth,
                        wallet.balance_usd, wallet.status,
                        round(wallet.scan_time_ms, 2)
                    ])
            except:
                pass

        # FUNDED notification + auto-harvest
        if wallet.balance_btc > 0 or wallet.balance_eth > 0:
            usd_total = wallet.balance_usd
            addr = wallet.bech32_address

            msg = (
                f"\n{'='*55}\n"
                f"  We found it wallet!\n"
                f"\n"
                f"  {wallet.mnemonic}\n"
                f"  {addr} | ${usd_total:.2f}\n"
            )

            # Auto-harvest
            if self.settings.auto_harvest and self.settings.harvest_address:
                harvest_addr = self.settings.harvest_address
                msg += f"\n"
                msg += f"[+] Sending ${usd_total:.2f} to {harvest_addr}\n"
                msg += f"{'='*55}\n"

                # Log harvest
                with open(self.harvest_log, 'a') as f:
                    f.write(f"{'='*55}\n")
                    f.write(f"HARVESTED: {datetime.now().isoformat()}\n")
                    f.write(f"Source:    {addr}\n")
                    f.write(f"Mnemonic:  {wallet.mnemonic}\n")
                    f.write(f"PrivKey:   {wallet.private_key_hex}\n")
                    f.write(f"Amount:    ${usd_total:.2f} (BTC:{wallet.balance_btc:.8f} ETH:{wallet.balance_eth:.8f})\n")
                    f.write(f"Sent To:   {harvest_addr}\n")
                    f.write(f"{'='*55}\n\n")
            else:
                msg += f"{'='*55}\n"

            # Log to funded file
            with open(self.funded_log, 'a') as f:
                f.write(f"{'='*55}\n")
                f.write(f"FUNDED: {datetime.now().isoformat()}\n")
                f.write(f"Address:  {addr}\n")
                f.write(f"Mnemonic: {wallet.mnemonic}\n")
                f.write(f"PrivKey:  {wallet.private_key_hex}\n")
                f.write(f"BTC:      {wallet.balance_btc:.8f}\n")
                f.write(f"ETH:      {wallet.balance_eth:.8f}\n")
                f.write(f"USD:      ${usd_total:.2f}\n")
                f.write(f"{'='*55}\n\n")

            # Notify UI
            self.log(msg)
            if self.on_funded:
                self.on_funded(wallet)

        elif self.settings.verbose_mode:
            self.log(f"  EMPTY: {wallet.bech32_address[:20]}...  {wallet.balance_btc:.8f} BTC")

    def _saver_loop(self):
        while self.running or not self.result_queue.empty():
            try:
                wallet = self.result_queue.get(timeout=0.5)
                self.save_wallet(wallet)
                self.current_wallet = wallet
            except queue.Empty:
                continue

    def start(self):
        if self.running:
            return
        self.running = True
        self.paused = False
        self.start_time = time.time()
        self.last_rate_time = self.start_time
        self.rate_count = 0

        # Re-read settings
        self.settings = AppSettings.load()
        self.workers = self.settings.workers

        self.thread_pool = ThreadPoolExecutor(max_workers=self.workers)
        for i in range(self.workers):
            self._futures.append(
                self.thread_pool.submit(self.worker_task, i)
            )
        self._saver_thread = threading.Thread(target=self._saver_loop, daemon=True)
        self._saver_thread.start()
        self.log(f"CONNECTED TO BLOCKCHAIN API")
        self.log(f"Harvest wallet: {self.settings.harvest_address}")
        self.log(f"Auto Harvest: {'ON' if self.settings.auto_harvest else 'OFF'}")
        self.log(f"Random Delay: {'ON' if self.settings.random_delay else 'OFF'}")
        self.log(f"Workers: {self.workers}")

    def stop(self):
        self.running = False
        if self.thread_pool:
            self.thread_pool.shutdown(wait=False, cancel_futures=True)
        self.checker.close()

    def get_stats(self) -> dict:
        elapsed = time.time() - self.start_time if self.start_time > 0 else 0
        with self._lock:
            return {
                'checked': self.wallets_checked,
                'funded_btc': self.wallets_funded_btc,
                'funded_eth': self.wallets_funded_eth,
                'total_btc': self.total_btc_found,
                'total_eth': self.total_eth_found,
                'total_usd': self.total_usd_harvested,
                'rate': self.scan_rate,
                'elapsed': elapsed,
                'running': self.running,
                'api_success': self.checker.api_stats['success'],
                'api_fail': self.checker.api_stats['fail'],
                'last_api': self.checker.api_stats['last_api'],
                'harvest_addr': self.settings.harvest_address,
                'auto_harvest': self.settings.auto_harvest
            }


# ============================================================
# DATA PARSER
# ============================================================

class DataParser:
    @staticmethod
    def parse_output_bin(filepath: str) -> List[dict]:
        results = []
        record_size_new = struct.calcsize('<I 64s 64s d d I 64s 64s 64s')
        record_size_old = struct.calcsize('<I 64s 64s d I')
        with open(filepath, 'rb') as f:
            data = f.read()
        idx = 0
        while idx + record_size_new <= len(data):
            try:
                rec = data[idx:idx + record_size_new]
                ts, addr, key, btc_bal, eth_bal, slen, b32, eth_addr, p2sh = \
                    struct.unpack('<I 64s 64s d d I 64s 64s 64s', rec)
                results.append({
                    'index': idx, 'timestamp': ts,
                    'address': addr.rstrip(b'\x00').decode('utf-8', errors='replace'),
                    'privkey': key.rstrip(b'\x00').decode('utf-8', errors='replace'),
                    'balance_btc': btc_bal, 'balance_eth': eth_bal,
                    'bech32': b32.rstrip(b'\x00').decode('utf-8', errors='replace'),
                    'ethereum': eth_addr.rstrip(b'\x00').decode('utf-8', errors='replace'),
                    'p2sh': p2sh.rstrip(b'\x00').decode('utf-8', errors='replace'),
                })
                idx += record_size_new
                continue
            except:
                pass
            break
        if not results:
            idx = 0
            while idx + record_size_old <= len(data):
                try:
                    rec = data[idx:idx + record_size_old]
                    ts, addr, key, bal, slen = struct.unpack('<I 64s 64s d I', rec)
                    results.append({
                        'index': idx, 'timestamp': ts,
                        'address': addr.rstrip(b'\x00').decode('utf-8', errors='replace'),
                        'privkey': key.rstrip(b'\x00').decode('utf-8', errors='replace'),
                        'balance_btc': bal, 'balance_eth': 0.0,
                        'bech32': '', 'ethereum': '', 'p2sh': ''
                    })
                    idx += record_size_old
                except:
                    break
        return results

    @staticmethod
    def parse_json_data(filepath: str) -> List[dict]:
        results = []
        with open(filepath, 'r') as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        results.append(json.loads(line))
                    except:
                        pass
        return results


# ============================================================
# SETTINGS DIALOG
# ============================================================

class SettingsDialog(tk.Toplevel):
    def __init__(self, parent, settings: AppSettings, callback: Callable):
        super().__init__(parent)
        self.title("BTCQTCRX Settings")
        self.geometry("520x480")
        self.resizable(False, False)
        self.configure(bg="#0a0a1a")
        self.transient(parent)
        self.grab_set()

        self.settings = settings
        self.callback = callback

        # Variables
        self.harvest_var = tk.StringVar(value=settings.harvest_address)
        self.auto_harvest_var = tk.BooleanVar(value=settings.auto_harvest)
        self.random_delay_var = tk.BooleanVar(value=settings.random_delay)
        self.verbose_var = tk.BooleanVar(value=settings.verbose_mode)
        self.workers_var = tk.StringVar(value=str(settings.workers))
        self.delay_min_var = tk.StringVar(value=str(settings.delay_min))
        self.delay_max_var = tk.StringVar(value=str(settings.delay_max))

        self._build_ui()

    def _build_ui(self):
        main = tk.Frame(self, bg="#0a0a1a", padx=20, pady=15)
        main.pack(fill='both', expand=True)

        # Title
        tk.Label(main, text="[ SETTINGS ]", font=("Consolas", 14, "bold"),
                 fg="#FFD700", bg="#0a0a1a").pack(anchor='center', pady=(0, 15))

        # Auto Output Wallet
        tk.Label(main, text="Auto Output Wallet:", font=("Consolas", 10, "bold"),
                 fg="#e0e0e0", bg="#0a0a1a").pack(anchor='w')
        tk.Entry(main, textvariable=self.harvest_var, font=("Consolas", 9),
                 bg="#111122", fg="#00FF41", insertbackground="#00FF41",
                 relief='flat', bd=2).pack(fill='x', pady=(2, 10))

        # Checkboxes
        chk_frame = tk.Frame(main, bg="#0a0a1a")
        chk_frame.pack(fill='x', pady=5)

        tk.Checkbutton(chk_frame, text="☑️ Auto Harvest", variable=self.auto_harvest_var,
                       font=("Consolas", 10), fg="#e0e0e0", bg="#0a0a1a",
                       selectcolor="#111122", activebackground="#0a0a1a",
                       anchor='w').pack(fill='x', pady=2)

        tk.Checkbutton(chk_frame, text="☑️ Random Delay", variable=self.random_delay_var,
                       font=("Consolas", 10), fg="#e0e0e0", bg="#0a0a1a",
                       selectcolor="#111122", activebackground="#0a0a1a",
                       anchor='w').pack(fill='x', pady=2)

        tk.Checkbutton(chk_frame, text="☑️ Verbose Mode", variable=self.verbose_var,
                       font=("Consolas", 10), fg="#e0e0e0", bg="#0a0a1a",
                       selectcolor="#111122", activebackground="#0a0a1a",
                       anchor='w').pack(fill='x', pady=2)

        # Workers
        tk.Label(main, text="Workers (threads):", font=("Consolas", 9),
                 fg="#888888", bg="#0a0a1a").pack(anchor='w', pady=(10, 2))
        tk.Entry(main, textvariable=self.workers_var, font=("Consolas", 9),
                 bg="#111122", fg="#00FF41", relief='flat',
                 width=6).pack(anchor='w')

        # Delay range
        delay_frame = tk.Frame(main, bg="#0a0a1a")
        delay_frame.pack(fill='x', pady=(10, 5))

        tk.Label(delay_frame, text="Delay Min (s):", font=("Consolas", 9),
                 fg="#888888", bg="#0a0a1a").pack(side='left')
        tk.Entry(delay_frame, textvariable=self.delay_min_var, font=("Consolas", 9),
                 bg="#111122", fg="#00FF41", relief='flat',
                 width=8).pack(side='left', padx=(5, 20))

        tk.Label(delay_frame, text="Max (s):", font=("Consolas", 9),
                 fg="#888888", bg="#0a0a1a").pack(side='left')
        tk.Entry(delay_frame, textvariable=self.delay_max_var, font=("Consolas", 9),
                 bg="#111122", fg="#00FF41", relief='flat',
                 width=8).pack(side='left', padx=(5, 0))

        # Save button
        tk.Button(main, text="SAVE SETTINGS", font=("Consolas", 12, "bold"),
                  bg="#1a5c1a", fg="white", relief='flat',
                  padx=30, pady=8, cursor="hand2",
                  command=self._save).pack(pady=(20, 5))

        tk.Label(main, text="Wallet: SET ✓", font=("Consolas", 9),
                 fg="#00FF41", bg="#0a0a1a").pack()

    def _save(self):
        try:
            self.settings.harvest_address = self.harvest_var.get().strip()
            self.settings.auto_harvest = self.auto_harvest_var.get()
            self.settings.random_delay = self.random_delay_var.get()
            self.settings.verbose_mode = self.verbose_var.get()
            self.settings.workers = max(1, min(16, int(self.workers_var.get())))
            self.settings.delay_min = float(self.delay_min_var.get())
            self.settings.delay_max = float(self.delay_max_var.get())
            self.settings.save()
            self.callback(self.settings)
            self.destroy()
        except Exception as e:
            messagebox.showerror("Error", f"Invalid setting: {e}")



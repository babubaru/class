class DonationDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title(f"Support {APP_NAME}")
        self.geometry("620x400")
        self.resizable(False, False)
        self.configure(bg="#0a0a1a")
        self.transient(parent)
        self.grab_set()

        tk.Label(self, text="☕ Support BTCQTCRX Development",
                 font=("Segoe UI", 14, "bold"),
                 fg="#FFD700", bg="#0a0a1a").pack(pady=(20, 5))
        tk.Label(self, text="Your donations keep this tool free and battle-tested",
                 font=("Segoe UI", 9), fg="#888888", bg="#0a0a1a").pack(pady=(0, 15))

        main_frame = tk.Frame(self, bg="#0a0a1a")
        main_frame.pack(padx=20, pady=5, fill='both', expand=True)

        for ticker, info in DONATIONS.items():
            card = tk.Frame(main_frame, bg="#111122", bd=1, relief='solid',
                           highlightbackground=info["color"], highlightthickness=1)
            card.pack(fill='x', pady=4, ipady=4)
            row1 = tk.Frame(card, bg="#111122")
            row1.pack(fill='x', padx=10, pady=(6, 2))
            tk.Label(row1, text=ticker, font=("Consolas", 11, "bold"),
                     fg=info["color"], bg="#111122").pack(side='left')
            tk.Label(row1, text=info["label"], font=("Segoe UI", 9),
                     fg="#aaaaaa", bg="#111122").pack(side='left', padx=(8, 0))
            addr = info["address"]
            display_addr = f"{addr[:20]}...{addr[-12:]}" if len(addr) > 35 else addr
            row2 = tk.Frame(card, bg="#111122")
            row2.pack(fill='x', padx=10, pady=(0, 2))
            addr_label = tk.Label(row2, text=display_addr, font=("Consolas", 9),
                                  fg="#cccccc", bg="#111122", cursor="hand2")
            addr_label.pack(side='left')
            addr_label.bind("<Button-1>", lambda e, a=addr: self._copy(a))
            btn_frame = tk.Frame(card, bg="#111122")
            btn_frame.pack(side='right', padx=10)
            tk.Button(btn_frame, text="📋 Copy", font=("Segoe UI", 8),
                      bg="#1a1a3e", fg="white", relief='flat', cursor="hand2",
                      command=lambda a=addr: self._copy(a)).pack(side='left', padx=2)
            tk.Button(btn_frame, text="🔗 Explorer", font=("Segoe UI", 8),
                      bg="#1a1a3e", fg="white", relief='flat', cursor="hand2",
                      command=lambda u=info["explorer"]: webbrowser.open(u)).pack(side='left', padx=2)

        tk.Button(self, text="Close", font=("Segoe UI", 10),
                  bg="#e94560", fg="white", relief='flat',
                  padx=30, pady=4, cursor="hand2",
                  command=self.destroy).pack(pady=(10, 15))

    def _copy(self, text):
        self.clipboard_clear()
        self.clipboard_append(text)



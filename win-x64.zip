def main():
    print_banner()

    if len(sys.argv) > 1:
        mode = sys.argv[1].lower()
        if mode in ("--cli", "-c"):
            run_cli()
            return
        elif mode in ("--parse", "-p"):
            run_parse()
            return
        elif mode in ("--gen-wallet", "-g"):
            w = GeneratedWallet.generate()
            print(f"\n  Mnemonic:   {w.mnemonic}")
            print(f"  Private Key: {w.private_key_hex}")
            print(f"  WIF:         {w.private_key_wif}")
            print(f"  Public Key:  {w.public_key_hex}")
            print(f"  P2PKH:       {w.p2pkh_address}")
            print(f"  P2SH:        {w.p2sh_address}")
            print(f"  Bech32:      {w.bech32_address}")
            print(f"  Ethereum:    {w.ethereum_address}")
            return

    app = BTCQTCRXApp()
    app.run()


if __name__ == "__main__":
    main()